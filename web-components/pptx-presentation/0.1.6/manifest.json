{
  "schema": "mcpgitrelease/web-component/v1",
  "id": "pptx-presentation",
  "version": "0.1.6",
  "api": 1,
  "element": "pptx-presentation",
  "source": {
    "repository": "yxsgit/works",
    "revision": "3860ad64daa673057b54660dfe6a0edb8124b021",
    "path": "pptx-source-preview-poc/src/pptx-presentation.js"
  },
  "artifact": {
    "file": "index.js",
    "sha256": "30cd886e79ba31b38f34901eb926f4bb2cbe3a7b73d3769121eeae9b6c7414b6",
    "integrity": "sha256-MM2Ibnm6MbOPNJAeuSb0uyy+Ontz03aRIe6um2x0FLY=",
    "size": 1614740
  },
  "contract": {
    "entry": "buildDeck(runtime, context)",
    "returns": [
      "ArrayBuffer",
      "{ bytes: ArrayBuffer, ...metadata }"
    ],
    "projectionInternals": "unrestricted",
    "methods": [
      "refresh(options?)",
      "download(filename?)",
      "next()",
      "previous()",
      "goTo(index)",
      "toggleFullscreen()"
    ],
    "attributes": {
      "initial-slide": "1-based initial slide",
      "current-slide": "1-based controlled/current slide"
    }
  },
  "lifecycle": {
    "sourceChange": "reset-to-current-slide-or-initial-slide",
    "refreshDefault": "preserve-current-slide",
    "refreshPreserveOption": true,
    "externalCurrentSlide": "drives-navigation",
    "currentSlideClamp": "clamp-and-canonicalize",
    "slidechangeDetail": [
      "index",
      "slide"
    ]
  },
  "dependencies": {
    "pptxgenjs": "4.0.1",
    "@aiden0z/pptx-renderer": "1.3.0"
  }

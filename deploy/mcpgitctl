#!/bin/sh
set -eu

# MCPGit product management facade.
# Container labels are discovery metadata. The persisted
# /data/.mcpgit-org-id remains the instance identity authority.

INSTANCE="${MCPGIT_INSTANCE:-mcpgit}"
URL="${MCPGIT_URL:-}"
PORT="${MCPGIT_PORT:-}"
DOCTOR_FAILURES=0

usage() {
  cat <<'EOF'
Usage: mcpgitctl [--instance NAME] [--url URL] <command>

Commands:
  status       Show installed instance, release, storage and health facts
  doctor       Cross-check the installation and print actionable failures
  logs         Show service logs
  upgrade      Verified Program-only upgrade; --check performs preflight only
  backup       Manage verified instance backups (reserved)

Environment: MCPGIT_INSTANCE, MCPGIT_URL and MCPGIT_PORT provide defaults.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --instance) [ $# -ge 2 ] || { echo "--instance requires NAME" >&2; exit 2; }; INSTANCE=$2; shift 2 ;;
    --url) [ $# -ge 2 ] || { echo "--url requires URL" >&2; exit 2; }; URL=$2; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) break ;;
  esac
done
COMMAND=${1:-help}

ok() { printf '  [OK] %s\n' "$1"; }
bad() { printf '  [FAIL] %s\n' "$1"; }
warn() { printf '  [WARN] %s\n' "$1"; }
doctor_ok() { ok "$1"; }
doctor_bad() { bad "$1"; DOCTOR_FAILURES=$((DOCTOR_FAILURES + 1)); }

docker_ready() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

container_exists() {
  docker container inspect "$INSTANCE" >/dev/null 2>&1
}

inspect() {
  docker inspect --format "$1" "$INSTANCE" 2>/dev/null || true
}

label() {
  inspect "{{index .Config.Labels \"$1\"}}"
}

container_state() {
  inspect '{{.State.Status}}'
}

container_health() {
  value=$(inspect '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}')
  [ -n "$value" ] && printf '%s\n' "$value" || printf '%s\n' unknown
}

image_ref() {
  inspect '{{.Config.Image}}'
}

data_volume() {
  value=$(label com.yxsicd.mcpgit.data-volume)
  if [ -z "$value" ]; then
    value=$(inspect '{{range .Mounts}}{{if eq .Destination "/data"}}{{if .Name}}{{.Name}}{{else}}{{.Source}}{{end}}{{end}}{{end}}')
  fi
  printf '%s\n' "$value"
}

endpoint() {
  if [ -n "$URL" ]; then
    printf '%s\n' "$URL"
    return
  fi
  port=$PORT
  if [ -z "$port" ] && command -v docker >/dev/null 2>&1 && container_exists; then
    mapped=$(docker port "$INSTANCE" 8001/tcp 2>/dev/null | tail -1 || true)
    [ -n "$mapped" ] && port=${mapped##*:}
  fi
  [ -n "$port" ] || port=8001
  printf 'http://127.0.0.1:%s\n' "$port"
}

persistent_org_id() {
  state=$(container_state)
  if [ "$state" = running ]; then
    docker exec "$INSTANCE" sh -c 'cat /data/.mcpgit-org-id 2>/dev/null || true' 2>/dev/null \
      | tr -d '[:space:]'
    return
  fi
  volume=$(data_volume)
  image=$(image_ref)
  if [ -n "$volume" ] && [ -n "$image" ]; then
    docker run --rm -v "$volume":/data --entrypoint sh "$image" -c \
      'cat /data/.mcpgit-org-id 2>/dev/null || true' 2>/dev/null \
      | tr -d '[:space:]'
  fi
}

safegit_agent_key_mode() {
  [ "$(container_state)" = running ] || return 0
  docker exec "$INSTANCE" sh -c \
    'p=/data/repos/safegit/.git/mcpgit/safegit-agent-key.v1.json; if [ -f "$p" ]; then stat -c %a "$p" 2>/dev/null || echo present; else echo missing; fi' \
    2>/dev/null || true
}

http_health_code() {
  command -v curl >/dev/null 2>&1 || return 0
  curl -sS -o /dev/null -w '%{http_code}' --max-time 3 "$(endpoint)/healthz" 2>/dev/null || true
}

print_value() {
  name=$1
  value=$2
  [ -n "$value" ] || value=unknown
  printf '  %-14s %s\n' "$name:" "$value"
}

status_cmd() {
  echo "MCPGit Status"
  echo "============="
  if ! docker_ready; then
    bad "Docker is unavailable"
    return 1
  fi
  if ! container_exists; then
    bad "Instance '$INSTANCE' is not installed"
    return 1
  fi

  org_label=$(label com.yxsicd.mcpgit.instance-id)
  org_persisted=$(persistent_org_id)
  program=$(label com.yxsicd.mcpgit.program-version)
  source=$(label org.opencontainers.image.revision)
  distribution=$(label com.yxsicd.mcpgit.distribution)
  manifest=$(label com.yxsicd.mcpgit.manifest-sha256)
  volume=$(data_volume)
  state=$(container_state)
  health=$(container_health)
  endpoint_value=$(endpoint)
  key_mode=$(safegit_agent_key_mode)

  echo
  echo "Instance"
  print_value "Name" "$INSTANCE"
  print_value "Organization" "${org_persisted:-$org_label}"

  echo
  echo "Release"
  print_value "Distribution" "$distribution"
  print_value "Program" "$program"
  print_value "Source" "$source"
  print_value "Manifest" "$manifest"

  echo
  echo "Runtime"
  print_value "Container" "$state"
  print_value "Health" "$health"
  print_value "Endpoint" "$endpoint_value"

  echo
  echo "Storage"
  print_value "Data volume" "$volume"

  echo
  echo "Security"
  case "$key_mode" in
    600) print_value "SafeGit AK" "present (0600)" ;;
    missing|'') print_value "SafeGit AK" "not observed" ;;
    *) print_value "SafeGit AK" "present (mode $key_mode)" ;;
  esac

  code=$(http_health_code)
  echo
  [ "$code" = 204 ] && ok "Service endpoint returned HTTP 204" || warn "Service endpoint health returned ${code:-no response}"
}

doctor_cmd() {
  echo "MCPGit Doctor"
  echo "============="
  echo
  echo "Environment"
  command -v docker >/dev/null 2>&1 && doctor_ok "Docker CLI installed" || doctor_bad "Docker CLI missing"
  if command -v docker >/dev/null 2>&1; then
    docker info >/dev/null 2>&1 && doctor_ok "Docker daemon reachable" || doctor_bad "Docker daemon unreachable"
  fi
  command -v curl >/dev/null 2>&1 && doctor_ok "curl installed" || doctor_bad "curl missing"
  [ -n "$INSTANCE" ] && doctor_ok "Instance name configured" || doctor_bad "Instance name is empty"

  if ! docker_ready; then
    echo
    echo "Result: $DOCTOR_FAILURES failure(s)"
    return 1
  fi

  echo
  echo "Installation"
  if ! container_exists; then
    doctor_bad "Instance '$INSTANCE' is not installed"
    echo
    echo "Result: $DOCTOR_FAILURES failure(s)"
    return 1
  fi
  doctor_ok "Instance container exists"

  volume=$(data_volume)
  if [ -n "$volume" ] && docker volume inspect "$volume" >/dev/null 2>&1; then
    doctor_ok "Data volume '$volume' exists"
  else
    doctor_bad "Data volume is missing or not discoverable"
  fi

  org_label=$(label com.yxsicd.mcpgit.instance-id)
  org_persisted=$(persistent_org_id)
  if [ -z "$org_persisted" ]; then
    doctor_bad "Persistent organization identity is missing"
  elif [ -z "$org_label" ]; then
    doctor_bad "Container is missing the product instance-id label"
  elif [ "$org_label" = "$org_persisted" ]; then
    doctor_ok "Container and persistent organization identity match"
  else
    doctor_bad "Container identity does not match the persistent data volume"
  fi

  for item in \
    "distribution:com.yxsicd.mcpgit.distribution" \
    "program version:com.yxsicd.mcpgit.program-version" \
    "source revision:org.opencontainers.image.revision" \
    "manifest digest:com.yxsicd.mcpgit.manifest-sha256"
  do
    title=${item%%:*}
    key=${item#*:}
    value=$(label "$key")
    [ -n "$value" ] && doctor_ok "Release $title is recorded" || doctor_bad "Release $title is missing"
  done

  echo
  echo "Runtime"
  state=$(container_state)
  [ "$state" = running ] && doctor_ok "Container is running" || doctor_bad "Container state is ${state:-unknown}"
  health=$(container_health)
  case "$health" in
    healthy) doctor_ok "Docker health is healthy" ;;
    none) warn "Container has no Docker health status; HTTP probe remains authoritative" ;;
    *) doctor_bad "Docker health is ${health:-unknown}" ;;
  esac
  code=$(http_health_code)
  [ "$code" = 204 ] && doctor_ok "$(endpoint)/healthz returned HTTP 204" || doctor_bad "$(endpoint)/healthz returned ${code:-no response}"

  echo
  echo "Security"
  key_mode=$(safegit_agent_key_mode)
  case "$key_mode" in
    600) doctor_ok "SafeGit restart Agent Key is present with mode 0600" ;;
    missing|'') doctor_bad "SafeGit restart Agent Key was not observed" ;;
    *) doctor_bad "SafeGit restart Agent Key mode is $key_mode (expected 600)" ;;
  esac

  echo
  if [ "$DOCTOR_FAILURES" -eq 0 ]; then
    echo "Result: healthy"
    return 0
  fi
  echo "Result: $DOCTOR_FAILURES failure(s)"
  return 1
}

case "$COMMAND" in
  status) status_cmd ;;
  doctor) doctor_cmd ;;
  logs)
    docker_ready || { echo "Docker is unavailable" >&2; exit 1; }
    container_exists || { echo "Instance '$INSTANCE' is not installed" >&2; exit 1; }
    docker logs "$INSTANCE"
    ;;
  upgrade)
    shift
    helper=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/install_state.py
    [ -f "$helper" ] || { echo 'Install the current product tools before upgrade' >&2; exit 2; }
    exec python3 "$helper" upgrade --instance "$INSTANCE" "$@"
    ;;
  backup)
    echo 'Verified backup orchestration is not implemented; no backup was created.' >&2
    exit 2
    ;;
  help) usage ;;
  *) usage >&2; exit 1 ;;
esac
